<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121.

     Apple silicon. There is no osx-x64 profile on purpose: an Intel Mac runs this one
     under Rosetta at a cost the renderer cannot afford, and every Mac that can play the
     game at frame rate is arm64.

     Vulkan on macOS is MoltenVK. The game finds it either from a Vulkan SDK installed on
     the machine or from libMoltenVK.dylib dropped into libs/osx-arm64, which is what
     Silk.NET's resolver is taught about by NativeLibraryLocator - see README, "Running on
     macOS". -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>publishmac\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
</Project>
