<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<!--
  The shipping layout: one executable, libs/<rid> beside it, content/ beside that.
  See Plan/01-architecture.md section 8.

  Single-file is what keeps the managed assemblies out of the install root - they go
  into the executable rather than being relocated, because moving managed DLLs would
  mean a probing-path or AssemblyLoadContext fallback that section 8 only sanctions if
  bundling cannot be used. Native libraries stay on disk, under libs/<rid>, put there
  by the targets in GK3Reborn.Host.csproj.

  Framework-dependent: the runtime is a prerequisite, not a payload. A self-contained
  variant is a second profile, not a flag flipped here.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native libraries belong in libs/<rid> as real files. Bundling them would make
         the executable self-extract into a temp directory at startup, which moves
         AppContext.BaseDirectory away from the install root and breaks every path the
         game derives from it - content, the shader cache, libs itself. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>

    <!-- Symbols travel inside the executable; XML docs are a build artefact, not part
         of a game install. Both would otherwise sit in the root as loose files. -->
    <DebugType>embedded</DebugType>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- The engine project is built by this same invocation but keeps its own DebugType,
         so its .pdb arrives as a reference-related file and has to be dropped here. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
