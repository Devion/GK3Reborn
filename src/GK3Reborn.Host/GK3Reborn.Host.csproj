<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GK3Reborn.Host</RootNamespace>
    <!-- The shipped executable is named for the game, not for this project. -->
    <AssemblyName>GK3Reborn</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StartupObject>GK3Reborn.Bootstrap.Program</StartupObject>
    <Version>0.2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="publishlinux\**" />
    <Compile Remove="publishmac\**" />
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publishlinux\**" />
    <EmbeddedResource Remove="publishmac\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publishlinux\**" />
    <None Remove="publishmac\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GK3Reborn.Engine/GK3Reborn.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced directly, not transitively: this assembly teaches Silk.NET's own path
         resolver about libs/<rid>, which is the loader the BCL hook cannot reach. -->
    <PackageReference Include="Silk.NET.Core" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="TestResults\" />
  </ItemGroup>

  <!-- ==================================================================================
       Clean publishing layout. See Plan/01-architecture.md section 8.

       A published tree is meant to be an executable, libs/<rid> and content/ - not the
       forty loose assemblies and eight-platform runtimes/ tree that a stock publish
       produces. Managed assemblies are bundled into the executable by single-file
       publishing (set in the publish profile); this file is what moves the native
       libraries, which single-file deliberately leaves on disk.

       Two sources feed libs/<rid>:

         - runtimes/<rid>/native/ from the Silk.NET packages - glfw3, soft_oal,
           shaderc_shared. Relocated below.
         - libs/<rid>/ beside the solution, where build/fetch-native.sh drops what is
           not on NuGet - MoltenVK on a Mac. That directory is gitignored, so a checkout
           without it publishes fine. The cutscenes need nothing here: the engine decodes
           H.264 and AAC itself (docs/formats/video.md).

       Set RebornCleanPublishLayout=false to publish the stock flat layout instead, which
       is worth having when bisecting a native-loading failure.
       ================================================================================== -->

  <Target Name="RebornRelocateNativeLibraries" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RebornCleanPublishLayout)' != 'false'">

    <ItemGroup>
      <!-- Publish is computed once per inner build, and MSBuild item state outlives a
           target, so both halves of this file clear their scratch items first and remove
           before they add. Without that, a second pass duplicates every relative path
           and the SDK fails the publish with NETSDK1152. -->
      <_RebornPortableNative Remove="@(_RebornPortableNative)" />
      <_RebornRidNative Remove="@(_RebornRidNative)" />
    </ItemGroup>

    <ItemGroup>
      <!-- A portable publish keeps the package's own runtimes/<rid>/native/ shape, so the
           RID is read back out of the path: two directories up from the file. -->
      <_RebornPortableNative Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/'))" />
      <_RebornPortableNative>
        <RebornRid>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(RelativePath)'))))))</RebornRid>
      </_RebornPortableNative>

      <!-- A RID-specific publish has already flattened them to the root, where they are
           only distinguishable from the managed assemblies by their asset type. The
           runtimes/ exclusion keeps the two halves disjoint: without it a portable
           publish matches both, and every native ships twice - once under its RID and
           once under a libs/ with no RID at all. -->
      <_RebornRidNative Include="@(ResolvedFileToPublish)" Condition="'$(RuntimeIdentifier)' != '' and '%(ResolvedFileToPublish.AssetType)' == 'native' and !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/'))" />
      <_RebornRidNative>
        <RebornRid>$(RuntimeIdentifier)</RebornRid>
      </_RebornRidNative>
    </ItemGroup>

    <ItemGroup>
      <_RebornRuntimesNative Remove="@(_RebornRuntimesNative)" />
      <_RebornRuntimesNative Include="@(_RebornPortableNative);@(_RebornRidNative)" />
      <_RebornRuntimesNative>
        <RelativePath>libs\%(RebornRid)\%(Filename)%(Extension)</RelativePath>
      </_RebornRuntimesNative>
    </ItemGroup>

    <ItemGroup>
      <!-- A publish for one RID carries that RID and no other. It has to be said here
           because a referenced project does not learn the RID: RuntimeIdentifier comes
           from a publish profile, which is a property of this project rather than a global
           property, and the SDK builds a RID-agnostic project reference with the RID
           removed. So GK3Reborn.Engine is built portable whatever is being published, and
           the two DXC libraries it places by hand - runtimes/win-x64 and runtimes/win-arm64,
           see its csproj - arrive in every publish including the ones that have no
           Direct3D at all.

           Harmless on Linux and fatal on a Mac: codesign treats a .dll inside a bundle as
           nested code, refuses to seal over one it cannot sign, and fails the whole bundle
           with "code object is not signed at all. In subcomponent: .../libs/win-x64/dxil.dll".
           Dropping the foreign RIDs is the fix and is right on its own terms - neither
           macOS nor Linux has a Direct3D path to feed. -->
      <_RebornForeignNative Remove="@(_RebornForeignNative)" />
      <_RebornForeignNative Include="@(_RebornRuntimesNative)" Condition="'$(RuntimeIdentifier)' != '' and '%(_RebornRuntimesNative.RebornRid)' != '$(RuntimeIdentifier)'" />
      <_RebornRuntimesNative Remove="@(_RebornForeignNative)" />
    </ItemGroup>

    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_RebornRuntimesNative)" />
      <ResolvedFileToPublish Remove="@(_RebornForeignNative)" />
      <ResolvedFileToPublish Include="@(_RebornRuntimesNative)" />
    </ItemGroup>
  </Target>

  <Target Name="RebornPublishSolutionNativeLibraries" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RebornCleanPublishLayout)' != 'false'">

    <ItemGroup>
      <_RebornSolutionNative Remove="@(_RebornSolutionNative)" />
    </ItemGroup>

    <!-- A RID-specific publish carries that RID's payload and no other; a portable one
         carries every RID present, matching the runtimes tree it replaces. -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
      <_RebornSolutionNative Include="$(RebornRoot)libs\$(RuntimeIdentifier)\**\*" />
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
      <_RebornSolutionNative Include="$(RebornRoot)libs\**\*" />
    </ItemGroup>

    <ItemGroup>
      <!-- A separate pass: well-known metadata such as %(Filename) is not available to
           inline metadata on the Include that creates the item, where it batches over an
           empty list and silently yields nothing. Relativising the source path against
           the checkout root also gets the subdirectories right without either branch
           above having to spell its own prefix out. -->
      <_RebornSolutionNative>
        <RebornRelativePath>$([MSBuild]::MakeRelative('$(RebornRoot)', '%(FullPath)'))</RebornRelativePath>
      </_RebornSolutionNative>
    </ItemGroup>

    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_RebornSolutionNative)" />
      <ResolvedFileToPublish Include="@(_RebornSolutionNative)">
        <RelativePath>%(_RebornSolutionNative.RebornRelativePath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>

    <!-- Not a warning: the solution's libs/ is gitignored and legitimately absent on a
         fresh checkout. Say so once, plainly, rather than shipping a silent gap. -->
    <Message Importance="high" Condition="'@(_RebornSolutionNative)' == ''" Text="GK3Reborn: no native payload found under $(RebornRoot)libs\. The published game will have no video decoder; see docs/formats/video.md." />
  </Target>

  <!-- ==================================================================================
       macOS application bundle. See README, "The macOS installer package".

       A Mac does not install a directory of files; it installs a GK3Reborn.app, and an
       installer package is a bundle wrapped in one. The bundle is not assembled after the
       publish - FolderProfileMac points PublishDir straight into Contents/MacOS, so the
       executable and the libs/<rid> tree the targets above build land in the right place
       to begin with, and AppContext.BaseDirectory is Contents/MacOS either way. All that
       is left is the metadata that makes the directory an application rather than a
       directory: Info.plist, PkgInfo, and the icon.

       Cross-platform on purpose. Assembling the bundle is file layout and an XML file, so
       a Windows machine can produce one; only signing and the .pkg need a Mac, and those
       are build/package-macos.sh.
       ================================================================================== -->

  <!-- WriteLinesToFile ends every line with Environment.NewLine, so the same source would
       give a CRLF file on Windows and an LF one on Linux. That matters here and nowhere
       else in the build: codesign hashes the bytes of every file in a bundle, so a
       host-dependent newline is a host-dependent signature, and this repository asks for
       builds that do not depend on which machine made them - see .gitattributes, and
       Deterministic in Directory.Build.props. Writing the text verbatim is the whole job. -->
  <UsingTask TaskName="RebornWriteText" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Path ParameterType="System.String" Required="true" />
      <Text ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Path));
        System.IO.File.WriteAllText(Path, Text, new System.Text.UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="RebornWriteMacAppBundle" AfterTargets="Publish" Condition="'$(RebornMacAppBundle)' == 'true'">

    <Error Condition="'$(RebornMacBundleRoot)' == ''" Text="RebornMacAppBundle needs RebornMacBundleRoot, the path of the .app. FolderProfileMac sets both." />

    <!-- Defaulted inside the target rather than in a PropertyGroup of their own: the
         switch that turns any of this on comes from a publish profile, and a profile is
         imported long after this file's body is evaluated. A conditional PropertyGroup out
         here would be read before the profile had said anything and would silently do
         nothing. A target's body is evaluated when the target runs, by which time
         everything has been read. -->
    <PropertyGroup>
      <RebornMacBundleIdentifier Condition="'$(RebornMacBundleIdentifier)' == ''">org.gk3reborn.game</RebornMacBundleIdentifier>
      <RebornMacBundleDisplayName Condition="'$(RebornMacBundleDisplayName)' == ''">GK3Reborn</RebornMacBundleDisplayName>
      <!-- MoltenVK's floor, and .NET 10's: neither runs on anything older. -->
      <RebornMacMinimumSystem Condition="'$(RebornMacMinimumSystem)' == ''">13.0</RebornMacMinimumSystem>
      <RebornMacIconSource Condition="'$(RebornMacIconSource)' == ''">$(RebornRoot)build\macos\AppIcon.png</RebornMacIconSource>
      <RebornMacPlistTemplate Condition="'$(RebornMacPlistTemplate)' == ''">$(RebornRoot)build\macos\Info.plist</RebornMacPlistTemplate>
    </PropertyGroup>

    <PropertyGroup>
      <_RebornBundleContents>$([MSBuild]::NormalizeDirectory('$(RebornMacBundleRoot)', 'Contents'))</_RebornBundleContents>
      <_RebornBundleResources>$([MSBuild]::NormalizeDirectory('$(_RebornBundleContents)', 'Resources'))</_RebornBundleResources>

      <!-- CFBundleShortVersionString is what the Finder shows and what an installer
           compares, and it accepts at most three integers - a fourth component makes the
           whole key invalid rather than being ignored, so an assembly version is trimmed
           to three here. -->
      <_RebornShortVersion>$(Version)</_RebornShortVersion>
      <_RebornShortVersion Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d+\.\d+\.\d+$'))">$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '\.\d+$', ''))</_RebornShortVersion>
    </PropertyGroup>

    <PropertyGroup>
      <_RebornPlist>$([System.IO.File]::ReadAllText('$(RebornMacPlistTemplate)'))</_RebornPlist>
      <_RebornPlist>$(_RebornPlist.Replace('@EXECUTABLE@', '$(AssemblyName)'))</_RebornPlist>
      <_RebornPlist>$(_RebornPlist.Replace('@IDENTIFIER@', '$(RebornMacBundleIdentifier)'))</_RebornPlist>
      <_RebornPlist>$(_RebornPlist.Replace('@NAME@', '$(AssemblyName)'))</_RebornPlist>
      <_RebornPlist>$(_RebornPlist.Replace('@DISPLAY_NAME@', '$(RebornMacBundleDisplayName)'))</_RebornPlist>
      <_RebornPlist>$(_RebornPlist.Replace('@SHORT_VERSION@', '$(_RebornShortVersion)'))</_RebornPlist>
      <_RebornPlist>$(_RebornPlist.Replace('@VERSION@', '$(Version)'))</_RebornPlist>
      <_RebornPlist>$(_RebornPlist.Replace('@MINIMUM_SYSTEM@', '$(RebornMacMinimumSystem)'))</_RebornPlist>
      <_RebornPlist>$(_RebornPlist.Replace('@COPYRIGHT@', '$(Copyright)'))</_RebornPlist>
      <_RebornPlist>$(_RebornPlist.Replace('@ICON@', 'AppIcon'))</_RebornPlist>
    </PropertyGroup>

    <MakeDir Directories="$(_RebornBundleResources)" />

    <RebornWriteText Path="$(_RebornBundleContents)Info.plist" Text="$(_RebornPlist)" />

    <!-- Classic, and still read by Launch Services before the plist is parsed. Eight bytes
         and no newline, which is the other reason not to use WriteLinesToFile. -->
    <RebornWriteText Path="$(_RebornBundleContents)PkgInfo" Text="APPL????" />

    <!-- The .icns is built from this PNG by build/package-macos.sh, which has sips and
         iconutil to do it with. Carrying the source into the bundle means a bundle handed
         to a Mac already has everything that step needs. A missing icon is not an error:
         the application runs and shows the generic one. -->
    <Copy SourceFiles="$(RebornMacIconSource)" DestinationFolder="$(_RebornBundleResources)" Condition="Exists('$(RebornMacIconSource)')" SkipUnchangedFiles="true" />

    <Message Importance="high" Text="GK3Reborn: wrote $(RebornMacBundleRoot)" />
    <Message Importance="high" Condition="!Exists('$(RebornMacIconSource)')" Text="GK3Reborn: no icon at $(RebornMacIconSource); the bundle will show the generic application icon." />
  </Target>

</Project>
