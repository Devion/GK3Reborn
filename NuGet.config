<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Builds must not depend on whatever sources a developer machine happens to
       have configured. Clear inherited sources and declare exactly one, so a
       restore resolves identically everywhere. See Plan/01-architecture.md
       section 1: do not float package versions. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
