<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Versions are pinned exactly. See Plan/01-architecture.md section 1:
       do not float package versions. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <!-- A pure-managed MP3 decoder. 97.5% of the game's audio is an MP3 inside a RIFF
         header, and decoding it in process is what lets the archives be read directly
         instead of keeping 3.7 GB of decoded copies beside them. -->
    <PackageVersion Include="NLayer" Version="2.0.1" />
    <PackageVersion Include="Silk.NET.Core" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Input" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Extensions.Soft" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Extensions.Creative" Version="2.23.0" />
    <!-- The bindings are separate from the library they bind; without this there is no
         soft_oal.dll to load and opening a device fails at runtime rather than at build. -->
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageVersion Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.23.0" />
    <!-- The Direct3D 12 backend. Silk surfaces D3D12 and DXGI as separate packages, and
         its D3D12 binding carries the whole of DXR - acceleration structures, state
         objects and the ray-query device flags - so ray tracing needs nothing further. -->
    <PackageVersion Include="Silk.NET.Direct3D12" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.DXGI" Version="2.23.0" />
    <!-- The back half of the shader chain. SPIRV-Cross turns SPIR-V into HLSL and DXC
         compiles that to DXIL; see Rendering/Shaders. Silk.NET.Direct3D.Compilers is the
         binding only, so Microsoft.Direct3D.DXC supplies the two native libraries: the
         compiler, and the dxil signing library without which every module is refused at
         pipeline creation. Its version is Microsoft's own scheme, not Silk's. -->
    <PackageVersion Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
    <PackageVersion Include="Microsoft.Direct3D.DXC" Version="1.9.2607.13" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <!-- An independent CRC32 for verifying the PNG writer's own implementation. -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

</Project>
