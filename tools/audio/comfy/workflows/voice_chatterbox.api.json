      "opt_narrator": [
        "2",
        0
      ],
      "enable_chunking": false,
      "enable_audio_cache": false
    }
  },
  "4": {
    "class_type": "SaveAudioWithPath",
    "_meta": {
      "title": "Straight into the content workspace"
    },
    "inputs": {
      "audio": [
        "3",
        0
      ],
      "folder_path": "REPLACED BY THE DRIVER",
      "subfolder_name": "dialogue",
      "filename": "REPLACED BY THE DRIVER",
      "suffix": "",
      "sample_rate": "48000",
      "bit_depth": "24-bit PCM",
      "overwrite": true,
      "normalize_clipping": true
    }
  }
}