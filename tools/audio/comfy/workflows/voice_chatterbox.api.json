{
  "1": {
    "class_type": "ChatterBoxEngineNode",
    "_meta": {
      "title": "ChatterBox, English"
    },
    "inputs": {
      "language": "English",
      "device": "auto",
      "exaggeration": 0.4,
      "temperature": 0.7,
      "cfg_weight": 0.5,
      "crash_protection_template": ""
    }
  },
  "2": {
    "class_type": "LoadAudio",
    "_meta": {
      "title": "Gabriel, from the archives"
    },
    "inputs": {
      "audio": "GK3_GABRIEL_REF.wav"
    }
  },
  "3": {
    "class_type": "UnifiedTTSTextNode",
    "_meta": {
      "title": "One line"
    },
    "inputs": {
      "TTS_engine": [
        "1",
        0
      ],
      "text": "REPLACED BY THE DRIVER",
